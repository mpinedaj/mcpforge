{
  "name": "@x123martin/mcpforge-cli",
  "version": "0.1.0",
  "description": "Turn any API into a secure MCP server in one command.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcpforge": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "api",
    "cli",
    "ai",
    "agents",
    "llm",
    "claude",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpinedaj/mcpforge.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/mpinedaj/mcpforge#readme",
  "bugs": {
    "url": "https://github.com/mpinedaj/mcpforge/issues"
  },
  "author": "Martin Pineda",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mcpforge/core": "0.1.0",
    "@mcpforge/inspector": "0.1.0",
    "@mcpforge/runtime": "0.1.0",
    "@mcpforge/shared": "0.1.0"
  }
}
