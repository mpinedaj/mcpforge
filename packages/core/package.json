{
  "name": "@mcpforge/core",
  "version": "0.1.0",
  "description": "OpenAPI to MCP tool manifest compiler for MCPForge.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@mcpforge/shared": "0.1.0",
    "openapi-types": "^12.1.3"
  }
}
