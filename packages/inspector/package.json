{
  "name": "@mcpforge/inspector",
  "version": "0.1.0",
  "description": "Zero-build inspector UI for MCPForge servers.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@mcpforge/shared": "0.1.0"
  }
}
